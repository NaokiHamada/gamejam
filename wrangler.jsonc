{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ittamon-jan",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "MahjongRoom"
      },
      {
        "name": "LIMITS",
        "class_name": "UsageLimits"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MahjongRoom",
        "UsageLimits"
      ]
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-6-luna",
    "DAILY_AI_LIMIT": "100"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "secrets_store_secrets": [
    {
      "binding": "OPENAI_KEY_STORE",
      "store_id": "83b796b35b854e15a8b418b2d4ce6bcc",
      "secret_name": "OPENAI_API_KEY"
    }
  ]
}

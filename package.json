    "smoke:npc": "node scripts/npc-smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@playwright/test": "^1.64.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  }
}
